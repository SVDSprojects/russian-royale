# Node 24.15+; copy to .env. No secrets needed for local testing.
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=./data/royale.sqlite
UPLOADS_DIR=./data/uploads
# Production public URL, e.g. https://royale.example.org
# PUBLIC_ORIGIN=https://royale.example.org
# NODE_ENV=production
# TRUST_PROXY=1
# Optional one-time token; prefer npm run admin -- your@email.example
# ADMIN_BOOTSTRAP_TOKEN=
# Force HTTPS-only cookies behind your TLS reverse proxy:
# COOKIE_SECURE=true
