{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "russian-royale",
  "account_id": "73de677825db9c4fb19e7f69f77cc549",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "html_handling": "none",
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/uploads/*", "/invite/*", "/admin"],
  },
  "durable_objects": { "bindings": [{ "name": "ROYALE", "class_name": "Royale" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Royale"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": { "NODE_ENV": "production", "COOKIE_SECURE": "true" },
}
